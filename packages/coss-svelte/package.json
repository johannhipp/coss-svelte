{
	"name": "coss-svelte",
	"version": "0.1.0",
	"description": "Svelte 5 copy-and-own component primitives inspired by COSS UI.",
	"private": false,
	"license": "MIT",
	"type": "module",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"check": "svelte-check --workspace . --tsconfig ./tsconfig.json --fail-on-warnings",
		"dev": "pnpm package:watch",
		"test": "vitest run",
		"test:ssr": "vitest run --config vite.ssr.config.ts",
		"package": "svelte-package -i src -o dist",
		"package:watch": "svelte-package -i src -o dist --watch",
		"prepack": "pnpm package"
	},
	"exports": {
		".": {
			"svelte": "./dist/index.js",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./metadata": {
			"types": "./dist/metadata.d.ts",
			"default": "./dist/metadata.js"
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/johannhipp/coss-svelte.git",
		"directory": "packages/coss-svelte"
	},
	"bugs": {
		"url": "https://github.com/johannhipp/coss-svelte/issues"
	},
	"homepage": "https://github.com/johannhipp/coss-svelte#readme",
	"keywords": [
		"svelte",
		"sveltekit",
		"components",
		"ui",
		"design-system",
		"bits-ui",
		"tailwindcss"
	],
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"bits-ui": "^2.18.1",
		"svelte": "^5.56.3"
	},
	"dependencies": {
		"clsx": "2.1.1",
		"tailwind-merge": "3.6.0"
	},
	"devDependencies": {
		"@internationalized/date": "3.12.2",
		"@sveltejs/package": "2.5.8",
		"@sveltejs/vite-plugin-svelte": "7.1.2",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/svelte": "5.4.2",
		"bits-ui": "2.18.1",
		"jsdom": "29.1.1",
		"svelte": "5.56.3",
		"svelte-check": "4.6.0",
		"typescript": "6.0.3",
		"vitest": "4.1.10"
	}
}
