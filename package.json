{
	"name": "@coss-svelte/monorepo",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.5.2",
	"engines": {
		"node": ">=22.0.0",
		"pnpm": ">=11.0.0"
	},
	"scripts": {
		"format": "biome format .",
		"format:write": "biome format --write .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"biome:check": "biome check .",
		"biome:ci": "biome ci .",
		"check": "pnpm -r --if-present check",
		"test": "pnpm -r --if-present test",
		"fetch:upstream": "node scripts/fetch-upstream.mjs",
		"scope:build": "node scripts/build-component-scope.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.16",
		"typescript": "6.0.3"
	}
}
