{
	"name": "@coss-svelte/monorepo",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.5.2",
	"engines": {
		"node": ">=22.0.0",
		"pnpm": ">=11.0.0"
	},
	"scripts": {
		"predev": "pnpm package:prepare",
		"dev": "pnpm --parallel --filter coss-svelte --filter @coss-svelte/www run dev",
		"format": "biome format .",
		"format:write": "biome format --write .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"biome:check": "biome check .",
		"biome:ci": "biome ci .",
		"check": "pnpm -r --if-present check",
		"test": "node scripts/validate-cn-classes.mjs && node --test tests/*.test.mjs && pnpm -r --if-present test",
		"pack:dry-run": "pnpm --filter coss-svelte exec npm pack --dry-run",
		"release:check": "pnpm package:prepare && pnpm api:check && pnpm biome:ci && pnpm check && pnpm package:index:check && pnpm scope:check && pnpm registry:check && pnpm theme:check && pnpm examples:check && pnpm test:type-consumer && pnpm test:consumer && pnpm test && pnpm --filter coss-svelte test:ssr && pnpm docs:release-gate && pnpm pack:dry-run",
		"fetch:upstream": "node scripts/fetch-upstream.mjs",
		"parity:evidence": "node scripts/capture-visual-parity-evidence.mjs",
		"parity:interactive": "node scripts/capture-interactive-visual-parity-evidence.mjs",
		"registry:build": "node scripts/build-registry.mjs",
		"registry:check": "node scripts/build-registry.mjs --check",
		"theme:check": "node scripts/check-theme.mjs",
		"examples:check": "node scripts/check-examples.mjs",
		"docs:bundle-report": "node scripts/docs-bundle-report.mjs",
		"docs:smoke": "pnpm --filter @coss-svelte/www build && pnpm docs:smoke:built",
		"docs:smoke:built": "node scripts/smoke-docs-server.mjs",
		"docs:release-gate": "pnpm --filter @coss-svelte/www build && pnpm docs:smoke:built && pnpm test:browser:built",
		"scope:build": "node scripts/build-component-scope.mjs",
		"scope:check": "node scripts/build-component-scope.mjs --check",
		"package:index": "node scripts/generate-package-index.mjs",
		"package:index:check": "node scripts/generate-package-index.mjs --check",
		"package:prepare": "pnpm --filter coss-svelte package",
		"api:build": "pnpm package:prepare && node scripts/build-api-reference.mjs",
		"api:check": "node scripts/build-api-reference.mjs --check",
		"test:browser": "pnpm --filter @coss-svelte/www build && pnpm test:browser:built",
		"test:browser:built": "node scripts/smoke-docs-browser.mjs",
		"test:browser:components": "pnpm --filter @coss-svelte/www build && node scripts/smoke-docs-browser.mjs --suite components",
		"test:consumer": "pnpm package:prepare && node scripts/check-clean-consumer.mjs",
		"test:type-consumer": "pnpm package:prepare && node scripts/check-type-consumer.mjs",
		"vercel:build": "pnpm package:prepare && pnpm --filter @coss-svelte/www build && node scripts/prepare-vercel-output.mjs"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.11.0",
		"@biomejs/biome": "2.4.16",
		"@playwright/test": "1.57.0",
		"typescript": "6.0.3"
	}
}
