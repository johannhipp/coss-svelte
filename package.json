{
	"name": "@coss-svelte/monorepo",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.5.2",
	"engines": {
		"node": ">=22.0.0",
		"pnpm": ">=11.0.0"
	},
	"scripts": {
		"format": "biome format .",
		"format:write": "biome format --write .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"biome:check": "biome check .",
		"biome:ci": "biome ci .",
		"check": "pnpm -r --if-present check",
		"test": "node scripts/validate-cn-classes.mjs && node --test tests/*.test.mjs && pnpm -r --if-present test",
		"pack:dry-run": "pnpm --filter coss-svelte exec npm pack --dry-run",
		"release:check": "pnpm biome:ci && pnpm check && pnpm test && pnpm pack:dry-run",
		"fetch:upstream": "node scripts/fetch-upstream.mjs",
		"parity:evidence": "node scripts/capture-visual-parity-evidence.mjs",
		"parity:interactive": "node scripts/capture-interactive-visual-parity-evidence.mjs",
		"registry:build": "node scripts/build-registry.mjs",
		"scope:build": "node scripts/build-component-scope.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.16",
		"typescript": "6.0.3"
	}
}
