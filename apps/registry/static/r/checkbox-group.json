{
	"name": "CheckboxGroup",
	"title": "Checkbox Group",
	"description": "A collection of related checkboxes with group-level control.",
	"type": "registry:ui",
	"files": [
		{
			"path": "packages/coss-svelte/src/components/CheckboxGroup.svelte",
			"target": "components/CheckboxGroup.svelte",
			"type": "registry:ui",
			"content": "<script lang=\"ts\">\nimport { Checkbox as CheckboxPrimitive } from \"bits-ui\";\nimport type { ComponentProps, Snippet } from \"svelte\";\nimport { cn } from \"../utils.js\";\n\ntype Props = Omit<ComponentProps<typeof CheckboxPrimitive.Group>, \"children\" | \"child\" | \"name\"> & {\n\tname?: string;\n\tlabel?: string;\n\tchildren?: Snippet;\n};\n\nlet {\n\tref = $bindable(null),\n\tvalue = $bindable([]),\n\tlabel = \"\",\n\tclass: className = \"\",\n\tchildren,\n\t...rest\n}: Props = $props();\n</script>\n\n<CheckboxPrimitive.Group\n\tbind:ref\n\tdata-slot=\"checkbox-group\"\n\tclass={cn(\"cn-choice-group\", className)}\n\tbind:value\n\t{...rest}\n>\n\t{#if label}\n\t\t<CheckboxPrimitive.GroupLabel class=\"cn-choice-label\">{label}</CheckboxPrimitive.GroupLabel>\n\t{/if}\n\t<div class=\"cn-choice-stack\">\n\t\t{@render children?.()}\n\t</div>\n</CheckboxPrimitive.Group>\n"
		},
		{
			"path": "packages/coss-svelte/src/utils.ts",
			"target": "utils.ts",
			"type": "registry:ui",
			"content": "import type { ClassValue } from \"clsx\";\nimport { clsx } from \"clsx\";\nimport { twMerge } from \"tailwind-merge\";\n\nexport function cn(...inputs: ClassValue[]): string {\n\treturn twMerge(clsx(inputs));\n}\n"
		}
	],
